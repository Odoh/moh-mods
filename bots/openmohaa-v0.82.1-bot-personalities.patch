+
+OpenMoHAA source code is free software; you can redistribute it
+and/or modify it under the terms of the GNU General Public License as
+published by the Free Software Foundation; either version 2 of the License,
+or (at your option) any later version.
+===========================================================================
+*/
+
+// playerbot_personality.h: per-bot personality profiles
+//
+// Profiles are read from "bot_personalities.cfg" (searched like any game
+// file: maintt/, mainta/, main/ or inside a pk3). Each [Name] section defines
+// one bot. Bots are named after the profiles in file order when they are
+// added without an explicit name. A built-in roster is used when the file is
+// missing.
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+struct BotPersonality {
+    std::string name  = "bot";
+    std::string style = "Default";
+
+    // primary weapon class: auto, rifle, smg, mg, sniper, shotgun, heavy
+    std::string weapon = "auto";
+
+    float spread     = 1.0f; // aim error multiplier (lower = more accurate)
+    float reactMin   = 200;  // ms before shooting a newly seen enemy
+    float reactMult  = 1.0f; // multiplier for the distance-based random reaction delay
+    float turn       = 1.0f; // turn speed multiplier
+    float aggression = 0.5f; // 0 = holds position & lets enemies go, 1 = always charges
+    float curiosity  = 1.0f; // chance multiplier to investigate heard sounds
+    float revenge    = 0.2f; // chance to return to where it was killed
+    float fireMin    = 500;  // ms of continuous fire before pausing
+    float fireRand   = 1500; // random ms added to fireMin
+    float burstMin   = 100;  // ms pause between bursts
+    float burstRand  = 500;  // random ms added to burstMin
+    float tauntChance = 0.2f; // chance to say something after a kill
+    float deathChance = 0.1f; // chance to say something after dying
+
+    std::vector<std::string> killLines;
+    std::vector<std::string> deathLines;
+};
+
+namespace BotPersonalities
+{
+// (Re)load profiles from bot_personalities.cfg, or fall back to built-ins
+void Load();
+// Profile for a bot name (case-insensitive). Unknown names get the default profile.
+const BotPersonality& Get(const char *name);
+// Name to give the n-th added bot (0-based), or NULL when there are no profiles
+const char *RosterName(int index);
+} // namespace BotPersonalities
