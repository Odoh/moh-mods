+static std::string Trim(const std::string& s)
+{
+    size_t a = 0, b = s.size();
+    while (a < b && isspace((unsigned char)s[a])) {
+        a++;
+    }
+    while (b > a && isspace((unsigned char)s[b - 1])) {
+        b--;
+    }
+    return s.substr(a, b - a);
+}
+
+static void SetKey(BotPersonality& p, const std::string& key, const std::string& val)
+{
+    float f = (float)atof(val.c_str());
+
+    if (!Q_stricmp(key.c_str(), "style")) {
+        p.style = val;
+    } else if (!Q_stricmp(key.c_str(), "weapon")) {
+        p.weapon = val;
+    } else if (!Q_stricmp(key.c_str(), "spread")) {
+        p.spread = f;
+    } else if (!Q_stricmp(key.c_str(), "react_min")) {
+        p.reactMin = f;
+    } else if (!Q_stricmp(key.c_str(), "react_mult")) {
+        p.reactMult = f;
+    } else if (!Q_stricmp(key.c_str(), "turn")) {
+        p.turn = f;
+    } else if (!Q_stricmp(key.c_str(), "aggression")) {
+        p.aggression = f;
+    } else if (!Q_stricmp(key.c_str(), "curiosity")) {
+        p.curiosity = f;
+    } else if (!Q_stricmp(key.c_str(), "revenge")) {
+        p.revenge = f;
+    } else if (!Q_stricmp(key.c_str(), "fire_min")) {
+        p.fireMin = f;
+    } else if (!Q_stricmp(key.c_str(), "fire_rand")) {
+        p.fireRand = f;
+    } else if (!Q_stricmp(key.c_str(), "burst_min")) {
+        p.burstMin = f;
+    } else if (!Q_stricmp(key.c_str(), "burst_rand")) {
+        p.burstRand = f;
+    } else if (!Q_stricmp(key.c_str(), "taunt_chance")) {
+        p.tauntChance = f;
+    } else if (!Q_stricmp(key.c_str(), "death_chance")) {
+        p.deathChance = f;
+    } else if (!Q_stricmp(key.c_str(), "kill_line")) {
+        p.killLines.push_back(val);
+    } else if (!Q_stricmp(key.c_str(), "death_line")) {
+        p.deathLines.push_back(val);
+    } else {
+        gi.Printf("bot_personalities: unknown key '%s' for %s\n", key.c_str(), p.name.c_str());
+    }
+}
+
+static void Parse(const char *text)
+{
+    std::string     all(text);
+    size_t          pos     = 0;
+    BotPersonality *current = NULL;
+
+    s_profiles.clear();
+
+    while (pos < all.size()) {
+        size_t      eol  = all.find('\n', pos);
+        std::string line = Trim(all.substr(pos, eol == std::string::npos ? std::string::npos : eol - pos));
+        pos              = (eol == std::string::npos) ? all.size() : eol + 1;
+
+        if (line.empty() || line[0] == '#' || line.compare(0, 2, "//") == 0) {
+            continue;
+        }
+
+        if (line[0] == '[') {
+            size_t close = line.find(']');
+            s_profiles.push_back(BotPersonality());
+            current       = &s_profiles.back();
+            current->name = Trim(line.substr(1, close == std::string::npos ? std::string::npos : close - 1));
+            continue;
+        }
+
+        size_t eq = line.find('=');
+        if (eq == std::string::npos || !current) {
+            continue;
+        }
+
+        SetKey(*current, Trim(line.substr(0, eq)), Trim(line.substr(eq + 1)));
+    }
+}
+
+void BotPersonalities::Load()
+{
+    void *buffer = NULL;
+    long  len    = gi.FS_ReadFile("bot_personalities.cfg", &buffer, qtrue);
+
+    if (len > 0 && buffer) {
+        std::string text((const char *)buffer, len);
+        gi.FS_FreeFile(buffer);
+        Parse(text.c_str());
+        gi.Printf("Loaded %d bot personalities from bot_personalities.cfg\n", (int)s_profiles.size());
+    } else {
+        Parse(s_builtin);
+        gi.Printf("Using %d built-in bot personalities (no bot_personalities.cfg)\n", (int)s_profiles.size());
+    }
+
+    for (size_t i = 0; i < s_profiles.size(); i++) {
+        gi.Printf(
+            "  %s (%s): weapon=%s spread=%.2f aggression=%.2f\n",
+            s_profiles[i].name.c_str(),
+            s_profiles[i].style.c_str(),
+            s_profiles[i].weapon.c_str(),
+            s_profiles[i].spread,
+            s_profiles[i].aggression
+        );
+    }
+
+    s_loaded = true;
+}
+
+const BotPersonality& BotPersonalities::Get(const char *name)
+{
+    if (!s_loaded) {
+        Load();
+    }
+
+    if (!name) {
+        return s_default;
+    }
+
+    for (size_t i = 0; i < s_profiles.size(); i++) {
+        if (!Q_stricmp(s_profiles[i].name.c_str(), name)) {
+            return s_profiles[i];
+        }
+    }
+
+    // "Hans2" -> "Hans" (extra copies of a profile get a number suffix)
+    std::string base(name);
+    while (!base.empty() && isdigit((unsigned char)base.back())) {
+        base.pop_back();
+    }
+    for (size_t i = 0; i < s_profiles.size(); i++) {
+        if (!Q_stricmp(s_profiles[i].name.c_str(), base.c_str())) {
+            return s_profiles[i];
+        }
+    }
+
+    return s_default;
+}
+
+const char *BotPersonalities::RosterName(int index)
+{
+    static char buf[64];
+
+    if (!s_loaded) {
+        Load();
+    }
+
+    if (s_profiles.empty() || index < 0) {
+        return NULL;
+    }
+
+    int n     = (int)s_profiles.size();
+    int round = index / n;
+
+    if (round == 0) {
+        Q_strncpyz(buf, s_profiles[index % n].name.c_str(), sizeof(buf));
+    } else {
+        Com_sprintf(buf, sizeof(buf), "%s%d", s_profiles[index % n].name.c_str(), round + 1);
+    }
+
+    return buf;
+}
